{
  "name": "vertexis-management-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "lint": "eslint .",
    "test:rules": "vitest run src/__tests__/firestore_rules.test.ts src/__tests__/firestore_transactions.test.ts",
    "test:rules:emulator": "firebase emulators:exec --only firestore --project demo-vertexis-audit --config firebase.emulators.json \"npm run test:rules\""
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "driver.js": "^1.8.0",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.0.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}
