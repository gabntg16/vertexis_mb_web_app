rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The web app reads and writes its domain collections from an authenticated
    // Firebase client. LocalStorage remains the offline-first fallback.
    function isAuthenticated() {
      return request.auth != null;
    }

    // The client currently has no custom claims or server-side role mapping.
    // Keep unauthenticated traffic blocked while the application establishes
    // its authenticated data boundary.
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
