rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Prototype data model:
    // - Auth custom claims are { role: 'admin' } or
    //   { role: 'branch', branchId: '<branch document id>' }.
    // - New users/{uid} documents are written by trusted Functions and have
    //   firebaseUid == uid. The browser never stores Auth passwords.
    // - Every branch-scoped record contains a required string branchId.
    // - Sales, audit, status-history, movement, and shift-close records are
    //   append-only from the browser; corrections are compensating records.

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true;
    }

    function isBranch() {
      return signedIn()
        && request.auth.token.role == 'branch'
        && request.auth.token.branchId is string
        && request.auth.token.branchId.size() > 0
        && get(/databases/$(database)/documents/branch_accounts/$(request.auth.uid)).data.isActive == true
        && get(/databases/$(database)/documents/branch_accounts/$(request.auth.uid)).data.branchId == request.auth.token.branchId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true
        && !(get(/databases/$(database)/documents/branches/$(request.auth.token.branchId)).data.status in ['suspended', 'archived', 'closed', 'deleted', 'Suspended', 'Archived', 'Closed', 'Deleted']);
    }

    function claimBranchId() {
      return request.auth.token.branchId;
    }

    function safeId(data) {
      return (!('id' in data) || (data.id is string && data.id.size() > 0 && data.id.size() <= 128))
        && data.keys().size() <= 80;
    }

    function safeOptionalText(data, field, maxLength) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLength);
    }

    function safeOptionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp || data[field] is string;
    }

    function branchData(data) {
      return safeId(data)
        && 'branchId' in data
        && data.branchId is string
        && data.branchId.size() > 0
        && data.branchId.size() <= 80
        && safeOptionalText(data, 'branchName', 160)
        && safeOptionalText(data, 'notes', 2000)
        && safeOptionalText(data, 'remarks', 2000)
        && safeOptionalText(data, 'reason', 1000)
        && safeOptionalText(data, 'performedBy', 160)
        && safeOptionalText(data, 'createdBy', 160)
        && safeOptionalTimestamp(data, 'updatedAt')
        && safeOptionalText(data, 'clientRequestId', 160)
        && safeOptionalText(data, 'idempotencyKey', 160);
    }

    function ownBranch(data) {
      return isBranch() && branchData(data) && data.branchId == claimBranchId();
    }

    function unchangedBranch() {
      return resource.data.branchId == request.resource.data.branchId
        && request.resource.data.branchId == claimBranchId();
    }

    function applicationData(data) {
      return safeId(data)
        && data.keys().hasOnly([
          'id', 'branchName', 'branchCode', 'businessType', 'address', 'contactNumber',
          'email', 'operatingHours', 'managerName', 'managerPhone', 'managerEmail',
          'managerGovId', 'documents', 'status', 'reviewNotes', 'rejectionReason',
          'revisionRemarks', 'submittedAt', 'updatedAt', 'reviewedAt', 'reviewedBy',
          'approvedBranchId'
        ])
        && safeOptionalText(data, 'branchName', 160)
        && safeOptionalText(data, 'address', 500)
        && safeOptionalText(data, 'email', 254)
        && safeOptionalText(data, 'managerEmail', 254)
        && safeOptionalText(data, 'managerGovId', 160)
        && safeOptionalText(data, 'reviewNotes', 2000)
        && safeOptionalText(data, 'rejectionReason', 1000)
        && safeOptionalText(data, 'revisionRemarks', 2000);
    }

    function accountData(data) {
      return safeId(data)
        && data.keys().hasOnly([
          'id', 'branchId', 'branchName', 'username', 'fullName', 'email', 'phone',
          'role', 'permissions', 'isActive', 'credentialsSent', 'credentialsSentAt',
          'createdAt', 'lastLoginAt', 'updatedAt'
        ])
        && branchData(data)
        && data.role in ['Branch Manager', 'Staff', 'Cashier', 'Inventory Specialist']
        && data.isActive is bool
        && data.permissions is list && data.permissions.size() <= 30
        && data.email is string
        && data.email.size() <= 254
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 160
        && !('temporaryPassword' in data);
    }

    function auditData(data) {
      return branchData(data)
        && data.keys().hasOnly([
          'id', 'branchId', 'branchName', 'action', 'remarks', 'changedBy', 'performedBy',
          'user', 'timestamp', 'createdAt', 'metadata', 'clientRequestId', 'idempotencyKey',
          'updatedAt'
        ])
        && ('action' in data)
        && data.action is string
        && data.action.size() > 0
        && data.action.size() <= 160;
    }

    function statusHistoryData(data) {
      return branchData(data)
        && data.keys().hasOnly([
          'id', 'branchId', 'branchName', 'previousStatus', 'newStatus', 'reason',
          'changedBy', 'timestamp', 'createdAt', 'updatedAt'
        ])
        && data.previousStatus is string
        && data.newStatus is string
        && data.reason is string
        && data.reason.size() <= 1000;
    }

    function canReadBranch(data) {
      return isAdmin() || (isBranch() && data.branchId == claimBranchId());
    }

    function canUpdateBranch() {
      return isAdmin() || (ownBranch(request.resource.data) && unchangedBranch());
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && userId == request.auth.uid);
      // Profiles and claims are provisioned/updated by Admin SDK only.
      allow write: if false;
    }

    match /branches/{branchId} {
      allow read: if isAdmin() || (isBranch() && branchId == claimBranchId());
      allow create, update, delete: if isAdmin();
    }

    function productData(data) {
      return safeId(data) && data.keys().hasOnly(['id', 'name', 'flavor', 'category', 'price', 'wholesalePrice', 'adminStock', 'updatedAt', 'updatedBy'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && data.flavor is string && data.flavor.size() <= 160
        && data.price is number && data.price >= 0 && data.price <= 100000000
        && (!('wholesalePrice' in data) || (data.wholesalePrice is number && data.wholesalePrice >= 0 && data.wholesalePrice <= 100000000))
        && data.adminStock is int && data.adminStock >= 0 && data.adminStock <= 1000000;
    }
    match /products/{productId} {
      allow read: if isAdmin() || isBranch();
      allow create, update: if isAdmin() && productData(request.resource.data);
      allow delete: if isAdmin();
    }

    function canReadAnnouncement(data) {
      return isAdmin() || (isBranch() && (data.get('scope', '') in ['nationwide', 'global'] || data.get('targetBranchId', '') == claimBranchId()));
    }
    match /announcements/{announcementId} {
      allow read: if canReadAnnouncement(resource.data);
      allow create, update: if isAdmin() && safeId(request.resource.data)
        && request.resource.data.title is string && request.resource.data.message is string
        && request.resource.data.get('scope', '') in ['nationwide', 'global', 'branch', 'commissary'];
      allow delete: if isAdmin();
    }
    match /events/{eventId} {
      allow read: if isAdmin() || (isBranch() && resource.data.branchId in ['ALL', claimBranchId()]);
      allow create, update: if isAdmin() && safeId(request.resource.data)
        && request.resource.data.title is string && request.resource.data.date is string
        && request.resource.data.branchId is string;
      allow delete: if isAdmin();
    }

    match /branch_applications/{applicationId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && applicationData(request.resource.data);
      allow delete: if isAdmin();
    }

    match /branch_documents/{documentId} {
      allow read: if canReadBranch(resource.data);
      allow create, update: if isAdmin() && branchData(request.resource.data);
      allow delete: if isAdmin();
    }

    match /branch_accounts/{accountId} {
      allow read: if canReadBranch(resource.data);
      allow create: if isAdmin() && accountData(request.resource.data);
      allow update: if isAdmin() && accountData(request.resource.data);
      allow delete: if isAdmin();
    }

    match /branch_status_history/{historyId} {
      allow read: if canReadBranch(resource.data);
      allow create: if isAdmin() || (ownBranch(request.resource.data) && statusHistoryData(request.resource.data));
      allow update, delete: if false;
    }

    match /branch_audit_logs/{logId} {
      allow read: if canReadBranch(resource.data);
      allow create: if isAdmin() || (ownBranch(request.resource.data) && auditData(request.resource.data));
      allow update, delete: if false;
    }

    match /sales/{recordId} {
      allow read: if canReadBranch(resource.data);
      allow write: if false; // Only validated, atomic callable transactions.
    }

    match /inventoryMovements/{recordId} {
      allow read: if canReadBranch(resource.data);
      allow write: if false; // Only validated, atomic callable transactions.
    }

    match /posAuditLogs/{auditId} {
      allow read: if canReadBranch(resource.data);
      allow create: if isAdmin() || (ownBranch(request.resource.data) && auditData(request.resource.data));
      allow update, delete: if false;
    }

    match /shiftClosings/{recordId} {
      allow read: if canReadBranch(resource.data);
      allow write: if false;
    }

    match /orders/{recordId} {
      allow read: if canReadBranch(resource.data);
      allow write: if false; // Only validated, atomic callable transactions.
    }

    match /deliveries/{recordId} {
      allow read: if canReadBranch(resource.data);
      allow write: if false; // Only validated, atomic callable transactions.
    }

    match /receivings/{recordId} {
      allow read: if canReadBranch(resource.data);
      allow write: if false; // Only validated, atomic callable transactions.
    }

    // InboundReceipt: immutable submitted item snapshot, branchId, status,
    // revision and manager review metadata. Trusted callable Functions validate
    // all fields and atomically apply stock; browser clients may only read.
    match /inbound_receipts/{receiptId} {
      allow read: if isAdmin() || (isBranch() && resource.data.branchId == claimBranchId());
      allow create, update, delete: if false;
    }

    function inventoryData(data) {
      return branchData(data) && data.keys().hasOnly(['id', 'branchId', 'productId', 'productName', 'stock', 'currentStock', 'minThreshold', 'updatedAt'])
        && data.productId is string && data.productName is string && data.stock is int && data.stock >= 0
        && (!('currentStock' in data) || data.currentStock == data.stock);
    }
    match /inventory/{inventoryId} {
      allow read: if canReadBranch(resource.data);
      allow create: if isAdmin() && inventoryData(request.resource.data) && request.resource.data.stock == 0;
      allow update: if isAdmin() && inventoryData(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['productName', 'minThreshold', 'updatedAt']);
      allow delete: if false;
    }

    match /daily_shift_logs/{logId} {
      allow read: if canReadBranch(resource.data);
      allow write: if false;
    }

    match /payment_proofs/{orderId} { allow read, write: if false; }
    match /transaction_requests/{requestId} { allow read, write: if false; }
    match /request_limits/{uid} { allow read, write: if false; }
    match /transaction_audit/{auditId} {
      allow read: if canReadBranch(resource.data);
      allow write: if false;
    }

    match /spoilage_records/{recordId} {
      allow read: if canReadBranch(resource.data);
      allow write: if false;
    }

    match /physical_audits/{recordId} {
      allow read: if canReadBranch(resource.data);
      allow write: if false;
    }

    match /birReceipts/{recordId} {
      allow read: if canReadBranch(resource.data);
      allow write: if false;
    }

    match /production_batches/{batchId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system_sync/{documentId} {
      allow read, write: if isAdmin();
    }

    // Any collection not explicitly listed above remains denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
